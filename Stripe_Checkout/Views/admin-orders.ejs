    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
      (() => {
        const naturalCaseClass = "item-text-wide-light-natural-case";
        const primaryItemTextWideLight = /^Item Text Wide Light$/i;
        const style = document.createElement("style");
        style.textContent = `.${naturalCaseClass} { text-transform: none !important; }`;
        document.head.appendChild(style);

        const syncTree = (root) => {
          if (!(root instanceof Element)) return;
          [root, ...root.querySelectorAll("*")].forEach((element) => {
            const primaryFamily = getComputedStyle(element).fontFamily
              .split(",")[0]
              .trim()
              .replace(/^['"]|['"]$/g, "");
            element.classList.toggle(naturalCaseClass, primaryItemTextWideLight.test(primaryFamily));
          });
        };

        const start = () => {
          syncTree(document.body);
          new MutationObserver((records) => {
            records.forEach((record) => record.addedNodes.forEach(syncTree));
            records.forEach((record) => {
              if (record.type === "attributes") syncTree(record.target);
            });
          }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["class", "style"] });
          const syncDocument = () => requestAnimationFrame(() => syncTree(document.body));
          window.addEventListener("resize", syncDocument);
          document.fonts?.ready.then(syncDocument);
        };

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
        else start();
      })();
    </script>
    <title>Order Management - Good Frame Admin</title>
    <meta name="robots" content="noindex, follow">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="shortcut icon" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">
    <style>body { margin: 0; }</style>
    <link rel="stylesheet" href="/Stripe_Checkout/Views/admin-desktop.css?v=20260713-fouc-fix" media="screen and (min-width: 1101px)">
    <link rel="stylesheet" href="/Stripe_Checkout/Views/admin-mobile.css?v=20260713-fouc-fix" media="screen and (max-width: 1100px)">
</head>
<body>
    <div class="admin-header">
        <h1>🖼️ Good Frame - Order Management</h1>
        <p>View completed orders with unique codes for fulfillment</p>
    </div>
    
    <button class="refresh-btn" onclick="window.location.reload()">🔄 Refresh Orders</button>
    
    <div class="orders-container">
        <div id="ordersContent">
            <!-- Orders will be loaded here -->
        </div>
    </div>

    <script>
        async function loadOrders() {
            try {
                const key = getAdminApiKey();
                if (!key) throw new Error('An admin API key is required.');
                const response = await fetch('/admin/orders', { headers:{ Authorization:`Bearer ${key}` } });
                if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error || 'Orders could not be loaded.');
                const orders = await response.json();
                
                const ordersContent = document.getElementById('ordersContent');
                
                if (!orders || orders.length === 0) {
                    ordersContent.innerHTML = '<div class="no-orders">No completed orders found. Orders will appear here after payment completion.</div>';
                    return;
                }
                
                ordersContent.innerHTML = orders.map(order => `
                    <div class="order-card">
                        <div class="order-header">
                            <div class="order-id">Order #${order.stripeSessionId.slice(-8)}</div>
                            <div class="order-status">${order.paymentStatus.toUpperCase()}</div>
                        </div>
                        
                        <div class="order-details">
                            <div class="detail-group">
                                <div class="detail-label">Customer Info</div>
                                <div class="detail-value">
                                    ${order.customerName || 'N/A'}<br>
                                    ${order.customerEmail || 'N/A'}
                                </div>
                            </div>
                            
                            <div class="detail-group">
                                <div class="detail-label">Order Total</div>
                                <div class="detail-value">
                                    $${order.totalAmount.toFixed(2)} ${order.currency.toUpperCase()}<br>
                                    <small>Placed: ${new Date(order.createdAt).toLocaleString()}</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="order-items">
                            <div class="items-header">📦 Items & Unique Codes:</div>
                            ${order.items.map(item => `
                                <div class="item">
                                    <div class="item-name">${item.finalProductName}</div>
                                    <div class="unique-code">🆔 CODE: #${item.uniqueCode}</div>
                                    ${/^\d{5}$/.test(String(item.uniqueCode || '')) ? `
                                        <div class="file-info" id="assets-${item.uniqueCode}">
                                            <button type="button" onclick="loadProductAssets('${item.uniqueCode}')">View ordered photos</button>
                                        </div>
                                    ` : ''}
                                    <div class="file-info">
                                        📁 Find files: ${item.originalObjectKey && item.thumbnailObjectKey
                                            ? `<strong>${item.originalObjectKey}</strong> and <strong>${item.thumbnailObjectKey}</strong>`
                                            : `<strong>${item.uniqueCode}_original_*</strong> and <strong>${item.uniqueCode}_thumbnail_*</strong>`}
                                    </div>
                                    <div class="item-details">
                                        ${item.size} | ${item.frameColor} Frame${item.photoCount ? ` | ${item.photoCount} Photos` : ''} | Qty: ${item.quantity} | $${item.amount.toFixed(2)}
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `).join('');
                
            } catch (error) {
                console.error('Error loading orders:', error);
                document.getElementById('ordersContent').innerHTML = '<div class="no-orders">Error loading orders. Please check the console.</div>';
            }
        }

        const checkoutWorkerBaseUrl = (window.GOOD_FRAME_CHECKOUT_API_BASE_URL || 'http://127.0.0.1:8787').replace(/\/$/, '');

        function getAdminApiKey() {
            let key = sessionStorage.getItem('goodFrameAdminApiKey') || '';
            if (!key) {
                key = window.prompt('Enter the order-management API key') || '';
                if (key) sessionStorage.setItem('goodFrameAdminApiKey', key);
            }
            return key;
        }

        async function downloadProductAsset(url, filename) {
            const key = getAdminApiKey();
            if (!key) return;
            const response = await fetch(`${checkoutWorkerBaseUrl}${url}`, { headers:{ Authorization:`Bearer ${key}` } });
            if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error || 'Download failed');
            const objectUrl = URL.createObjectURL(await response.blob());
            const link = document.createElement('a');
            link.href = objectUrl;
            link.download = filename;
            link.click();
            window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
        }

        async function loadProductAssets(productCode) {
            const container = document.getElementById(`assets-${productCode}`);
            const key = getAdminApiKey();
            if (!container || !key) return;
            container.textContent = 'Loading ordered photos…';
            try {
                const response = await fetch(`${checkoutWorkerBaseUrl}/admin/product-assets/${productCode}`, {
                    headers:{ Authorization:`Bearer ${key}` }
                });
                const assets = await response.json();
                if (!response.ok) throw new Error(assets.error || 'Files could not be loaded');
                container.replaceChildren();
                const summary = document.createElement('div');
                summary.textContent = `${assets.photoCount} photos · ${assets.frameColour || 'Frame colour unavailable'}`;
                container.append(summary);
                [...assets.photos, ...(assets.legacyPdf ? [assets.legacyPdf] : [])].forEach((asset) => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.textContent = `Download ${asset.filename}`;
                    button.addEventListener('click', () => downloadProductAsset(asset.downloadUrl, asset.filename).catch(error => window.alert(error.message)));
                    container.append(button);
                });
            } catch (error) {
                container.textContent = error.message;
            }
        }
        
        // Load orders when page loads
        document.addEventListener('DOMContentLoaded', loadOrders);
    </script>
</body>
</html>
