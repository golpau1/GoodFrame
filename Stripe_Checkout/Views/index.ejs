    <script>
        (() => {
            function updateCartCount() {
                const visualCart = JSON.parse(localStorage.getItem('myAppVisualCart') || '[]');
                const cartCountSpan = document.querySelector('.cart-nav .cart-count');
                if (cartCountSpan) {
                    cartCountSpan.textContent = visualCart.length;
                }
            }

            updateCartCount();

            window.addEventListener('storage', function(e) {
                if (e.key === 'myAppVisualCart') {
                    updateCartCount();
                }
            });

            const burgerMenu = document.getElementById('burgerMenu');
            const mobileNav = document.getElementById('mobileNav');
            const mobileNavOverlay = document.getElementById('mobileNavOverlay');
            const mobileNavClose = document.getElementById('mobileNavClose');

            function toggleMobileNav() {
                burgerMenu.classList.toggle('active');
                mobileNav.classList.toggle('active');
                mobileNavOverlay.style.display = mobileNavOverlay.style.display === 'block' ? 'none' : 'block';
            }

            function closeMobileNav() {
                burgerMenu.classList.remove('active');
                mobileNav.classList.remove('active');
                mobileNavOverlay.style.display = 'none';
            }

            if (burgerMenu) {
                burgerMenu.addEventListener('click', toggleMobileNav);
            }

            if (mobileNavOverlay) {
                mobileNavOverlay.addEventListener('click', closeMobileNav);
            }

            if (mobileNavClose) {
                mobileNavClose.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    closeMobileNav();
                });
            }

            document.querySelectorAll('.mobile-nav a').forEach(link => {
                link.addEventListener('click', closeMobileNav);
            });
        })();
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // A runtime override can point checkout at a different deployed API.
            const checkoutApiBaseUrl = (
                window.GOOD_FRAME_CHECKOUT_API_BASE_URL ||
                'https://good-frame-checkout.loganwallace049.workers.dev'
            ).trim().replace(/\/$/, '');

            let visualCartItems = [];
            let checkoutInProgress = false;

            function getCheckoutSessionEndpoint() {
                if (checkoutApiBaseUrl) {
                    return `${checkoutApiBaseUrl}/create-checkout-session`;
                }

                const isLocalHost = ['localhost', '127.0.0.1'].includes(window.location.hostname);

                if (window.location.protocol === 'file:' || (isLocalHost && window.location.port !== '3000')) {
                    return 'http://localhost:3000/create-checkout-session';
                }

                if (isLocalHost || window.location.port === '3000') {
                    return '/create-checkout-session';
                }

                return '';
            }

            async function readCheckoutError(response) {
                const fallback = response.statusText || 'Unable to create checkout session';
                const text = await response.text();

                if (!text) {
                    return fallback;
                }

                try {
                    const errorData = JSON.parse(text);
                    return errorData.error || fallback;
                } catch {
                    return fallback;
                }
            }

            function setCheckoutLoading(isLoading) {
                document.querySelectorAll(".checkout-button").forEach(button => {
                    if (!button.dataset.defaultText) {
                        button.dataset.defaultText = button.textContent.trim();
                    }

                    button.disabled = isLoading;
                    button.textContent = isLoading ? "Opening checkout..." : button.dataset.defaultText;
                });
            }

            function saveVisualCartToLocalStorage() {
                localStorage.setItem('myAppVisualCart', JSON.stringify(visualCartItems));
            }

            function loadVisualCartFromLocalStorage() {
                const storedCart = localStorage.getItem('myAppVisualCart');
                if (storedCart) {
                    visualCartItems = JSON.parse(storedCart);
                }
            }

            const cartFrameImages = {
                Black: {
                    landscape: "https://static.wixstatic.com/media/4db74a_aca803f39a194834a0f785ee0ed9829e~mv2.png",
                    portrait: "https://static.wixstatic.com/media/4db74a_d3911e189f104d37930b16e303bd7fc8~mv2.png",
                    landscapeAddBorder: "https://static.wixstatic.com/media/4db74a_e7e6a449359f4099b4f8ec688ccaf8c5~mv2.png",
                    portraitAddBorder: "https://static.wixstatic.com/media/4db74a_27c8b0b646c444e9915208ebdf219b03~mv2.png"
                },
                White: {
                    landscape: "https://static.wixstatic.com/media/4db74a_ce460b15ab364b4e98f29490c882b6fd~mv2.png",
                    portrait: "https://static.wixstatic.com/media/4db74a_695e900b36de4d62b7853d4a75999a21~mv2.png",
                    landscapeAddBorder: "https://static.wixstatic.com/media/4db74a_f1d86c172d27450da30dcbf804385c47~mv2.png",
                    portraitAddBorder: "https://static.wixstatic.com/media/4db74a_02584d6d018d4399a59100835bd3d806~mv2.png"
                },
                Natural: {
                    landscape: "https://static.wixstatic.com/media/4db74a_6cbf0df4c7ec418a9d4cde5ab833181d~mv2.png",
                    portrait: "https://static.wixstatic.com/media/4db74a_b920602155eb4db6aecc02651f8f4516~mv2.png",
                    landscapeAddBorder: "https://static.wixstatic.com/media/4db74a_060d3c24638e4e98af90abbb11963661~mv2.png",
                    portraitAddBorder: "https://static.wixstatic.com/media/4db74a_da184c93a4a34324914d45eb147cfbc8~mv2.png"
                }
            };

            function escapeCartAttribute(value) {
                return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/"/g, "&quot;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
            }

            function getCartFrameOverlayUrl(item) {
                if (item.frameOverlayUrl) {
                    return item.frameOverlayUrl;
                }

                const frameColor = cartFrameImages[item.frameColor] ? item.frameColor : "Black";
                const orientation = item.orientation === "Portrait" ? "portrait" : "landscape";
                const borderSuffix = item.border === "Add Border" ? "AddBorder" : "";
                return cartFrameImages[frameColor][`${orientation}${borderSuffix}`] || "";
            }

            function getCartPhotoPlacement(item) {
                const isPortrait = item.orientation === "Portrait";
                const hasBorder = item.border === "Add Border";

                if (isPortrait) {
                    return hasBorder
                        ? { width: "49.333%", height: "74%" }
                        : { width: "55.333%", height: "83%" };
                }

                return hasBorder
                    ? { width: "74%", height: "49.333%" }
                    : { width: "83%", height: "55.333%" };
            }

            function renderCartThumbnail(item, itemImageSrc) {
                const photoSrc = item.previewImage || item.originalImageUrl;
                const frameOverlayUrl = getCartFrameOverlayUrl(item);

                if (!photoSrc || !frameOverlayUrl) {
                    return `<img src="${escapeCartAttribute(itemImageSrc)}" alt="Picture Frame" class="cart-item-image">`;
                }

                const placement = getCartPhotoPlacement(item);
                return `
                    <div class="cart-item-image cart-frame-preview" aria-label="Picture Frame" style="position: relative; overflow: hidden; background: #fff; flex: 0 0 auto;">
                        <img src="${escapeCartAttribute(photoSrc)}" alt="" style="position: absolute; left: 50%; top: 50%; width: ${placement.width}; height: ${placement.height}; transform: translate(-50%, -50%); object-fit: cover; object-position: center center;">
                        <img src="${escapeCartAttribute(frameOverlayUrl)}" alt="" crossorigin="anonymous" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: center center;">
                    </div>
                `;
            }

            function updateCartUI() {
                const cartItemsContainer = document.getElementById("cartItems");
                const cartSummaryContainer = document.getElementById("cartSummary");
                const cartNavCountSpan = document.querySelector(".cart-nav .cart-count");
                const mainContainer = document.querySelector(".cart-page-container");

                if (cartNavCountSpan) {
                    cartNavCountSpan.textContent = visualCartItems.length;
                }

                if (visualCartItems.length === 0) {
                    mainContainer.classList.add("cart-empty");
                    cartItemsContainer.innerHTML = '<div class="empty-cart-message">Your cart is empty.</div>';
                    cartSummaryContainer.style.display = "none";
                    return;
                }

                // If we reach here, the cart is not empty, so remove the class and show the summary
                mainContainer.classList.remove("cart-empty");
                cartSummaryContainer.style.display = "block";

                cartItemsContainer.innerHTML = '';
                visualCartItems.forEach((item, index) => {
                    const cartItemElement = document.createElement("div");
                    cartItemElement.className = "cart-item";
                    // Update product name display to "Print & Frame" and handle various formats
                    let displayName = item.productName;
                    if (displayName && displayName.includes("Print with Frame")) {
                        displayName = displayName.replace("Print with Frame", "Print & Frame");
                    } else if (displayName === "Print With Frame") {
                        displayName = "Print & Frame";
                    }
                    const placeholderImage = 'https://via.placeholder.com/100/1E1E1E/EAEAEA?text=No+Img';
                    const itemImageSrc = item.image || item.thumbnailUrl || item.fallbackImage || item.originalImageUrl || placeholderImage;
                    cartItemElement.innerHTML = `
                        ${renderCartThumbnail(item, itemImageSrc)}
                        <div class="cart-item-details">
                            <div class="cart-item-title">${displayName}</div>
                            <div class="cart-item-meta">
                                ${item.size} | ${item.orientation} | ${item.frameColor} Frame | ${item.border}
                            </div>
                        </div>
                        <div class="cart-item-price">$${(item.price || 0).toFixed(2)}</div>
                        <button class="remove-item" data-index="${index}" title="Remove">×</button>
                    `;
                    cartItemsContainer.appendChild(cartItemElement);
                });

                const subtotal = visualCartItems.reduce((sum, item) => sum + (item.price || 0), 0);
                const shipping = subtotal > 100 ? 0 : 15;
                const total = subtotal + shipping;

                cartSummaryContainer.innerHTML = `
                        <div class="cart-total">
                            <span>Subtotal</span>
                            <span>$${subtotal.toFixed(2)}</span>
                        </div>
                        <div class="cart-total">
                            <span>Shipping</span>
                            <span>${shipping === 0 ? 'Free' : `$${shipping.toFixed(2)}`}</span>
                        </div>
                        <div class="cart-total grand-total">
                            <span>Total</span>
                            <span>$${total.toFixed(2)}</span>
                        </div>
                        <div class="cart-actions">
                            <button class="cart-button checkout-button">Proceed to checkout</button>
                            <a href="../Print-Frame/print-frame.html" class="cart-button continue-shopping">Continue shopping</a>
                        </div>
                `;

                attachEventListeners();
            }

            function removeItemFromCart(index) {
                if (index > -1 && index < visualCartItems.length) {
                    visualCartItems.splice(index, 1);
                    saveVisualCartToLocalStorage();
                    updateCartUI();
                }
            }

            function attachEventListeners() {
                document.querySelectorAll(".remove-item").forEach(button => {
                    button.replaceWith(button.cloneNode(true));
                });
                document.querySelectorAll(".remove-item").forEach(button => {
                    button.addEventListener("click", (e) => {
                        const indexToRemove = parseInt(e.currentTarget.getAttribute("data-index"));
                        removeItemFromCart(indexToRemove);
                    });
                });

                const checkoutButton = document.querySelector(".checkout-button");
                if (checkoutButton) {
                    checkoutButton.addEventListener("click", handleCheckout);
                }
            }

            async function handleCheckout() {
                if (checkoutInProgress) {
                    return;
                }

                let cart = [];
                const storedCart = localStorage.getItem('myAppVisualCart');
                if (storedCart) {
                    cart = JSON.parse(storedCart);
                }
                
                if (cart.length === 0) {
                    alert("Your cart is empty. Please add items before checking out.");
                    return;
                }

                const checkoutItems = cart.map(item => ({
                    uniqueCode: item.uniqueCode,
                    size: item.size,
                    orientation: item.orientation,
                    frameColor: item.frameColor,
                    border: item.border,
                    quantity: 1,
                }));

                let redirectingToStripe = false;
                checkoutInProgress = true;
                setCheckoutLoading(true);

                try {
                    const checkoutEndpoint = getCheckoutSessionEndpoint();

                    if (!checkoutEndpoint) {
                        throw new Error('Checkout is not connected on the live site yet.');
                    }

                    const response = await fetch(checkoutEndpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ items: checkoutItems }),
                    });

                    // Check if the server responded with an error before parsing JSON
                    if (!response.ok) {
                        const errorMessage = await readCheckoutError(response);
                        throw new Error(`Server error: ${errorMessage}`);
                    }

                    const session = await response.json();

                    if (!session.url) {
                        throw new Error("Could not create checkout session.");
                    }

                    window.location.assign(session.url);
                    redirectingToStripe = true;
                } catch (error) {
                    console.error('Error:', error);
                    const message = error instanceof Error && error.message
                        ? error.message
                        : 'An error occurred during checkout.';
                    alert(`${message} Please refresh and try again.`);
                } finally {
                    if (!redirectingToStripe) {
                        checkoutInProgress = false;
                        setCheckoutLoading(false);
                    }
                }
            }
            
            loadVisualCartFromLocalStorage();
            updateCartUI();
        });
    </script>
</body>
