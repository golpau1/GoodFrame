    <footer class="footer" style="background: #070707; color: #f9f2e6;">
        <div class="footer-content">
            <div class="footer-col">
                <h3 class="footer-title footer-girthquake" style="font-family: 'Girthquake', 'NType82', 'Helvetica Neue', Arial, sans-serif !important; letter-spacing: 0 !important;">Navigation</h3>
                <ul>
                    <li><a href="../Print-Frame/print-frame.html">Print & Frame</a></li>
                    <li><a href="../Pricing/pricing.html">Pricing</a></li>
                    <li><a href="../About Us/AboutUs.html">Contact Us</a></li>
                    <li><a href="../FAQ/FAQ.html">FAQ</a></li>
                    <li><a href="../About Us/AboutUs.html">About Us</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3 class="footer-title footer-girthquake" style="font-family: 'Girthquake', 'NType82', 'Helvetica Neue', Arial, sans-serif !important; letter-spacing: 0 !important;">Contact</h3>
                <p><a href="mailto:contact.goodframe@gmail.com">contact.goodframe@gmail.com</a></p>
            </div>

            <div class="footer-col">
                <h3 class="footer-title footer-girthquake" style="font-family: 'Girthquake', 'NType82', 'Helvetica Neue', Arial, sans-serif !important; letter-spacing: 0 !important;">Social</h3>
                <ul>
                    <li><a href="#">Instagram</a></li>
