{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "good-frame-checkout",
  "main": "src/index.js",
  "compatibility_date": "2026-06-08",
  "vars": {
    "STRIPE_MODE": "live",
    "SITE_BASE_URL": "https://goodframe.com.au",
    "ALLOWED_ORIGINS": "https://goodframe.com.au",
    "PENDING_UPLOAD_TTL_DAYS": "10",
    // Sender shown on the order-confirmation email. The domain here must
    // be a verified sender domain in Resend before this works - update
    // once that's done (see Stripe_Checkout/worker/src/index.js).
    "RESEND_FROM_EMAIL": "Good Frame <orders@goodframe.com.au>",
    "SUPPORT_EMAIL": "contact.goodframe@gmail.com"
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK_BUCKET",
      "bucket_name": "goodframes"
    }
  ],
  "d1_databases": [
    {
      "binding": "PRODUCT_CODES_DB",
      "database_name": "good-frame-product-codes",
      "database_id": "39f74d95-8bb9-4063-aed8-dab0b78e6b95",
      "migrations_dir": "migrations"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "env": {
    "dev": {
      "vars": {
        "STRIPE_MODE": "test",
        "SITE_BASE_URL": "http://127.0.0.1:4173",
        "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500",
        "PENDING_UPLOAD_TTL_DAYS": "10",
        "RESEND_FROM_EMAIL": "Good Frame <orders@goodframe.com.au>",
        "SUPPORT_EMAIL": "contact.goodframe@gmail.com"
      },
      "r2_buckets": [
        {
          "binding": "ARTWORK_BUCKET",
          "bucket_name": "goodframes-test"
        }
      ],
      "d1_databases": [
        {
          "binding": "PRODUCT_CODES_DB",
          "database_name": "good-frame-product-codes-test",
          "database_id": "d7788cb4-04be-4d62-a08c-ccada2c3f21a",
          "migrations_dir": "migrations"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    },
    "test": {
      "name": "good-frame-checkout-test",
      "vars": {
        "STRIPE_MODE": "test",
        "SITE_BASE_URL": "http://127.0.0.1:4173",
        "ALLOWED_ORIGINS": "http://localhost:4173,http://127.0.0.1:4173",
        "PENDING_UPLOAD_TTL_DAYS": "10",
        "RESEND_FROM_EMAIL": "Good Frame <orders@goodframe.com.au>",
        "SUPPORT_EMAIL": "contact.goodframe@gmail.com"
      },
      "r2_buckets": [
        {
          "binding": "ARTWORK_BUCKET",
          "bucket_name": "goodframes-test"
        }
      ],
      "d1_databases": [
        {
          "binding": "PRODUCT_CODES_DB",
          "database_name": "good-frame-product-codes-test",
          "database_id": "d7788cb4-04be-4d62-a08c-ccada2c3f21a",
          "migrations_dir": "migrations"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
  // Required production secrets (set without --env; never commit values):
  //   STRIPE_LIVE_SECRET_KEY
  //   STRIPE_LIVE_PUBLISHABLE_KEY (reserved for Stripe.js if added later)
  //   STRIPE_LIVE_WEBHOOK_SECRET
  //   RESEND_API_KEY
  //   ADMIN_API_KEY           (protects product-code lookup and capacity endpoints)
  // Existing STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET remain supported as
  // live-only migration fallbacks, so the current production setup is intact.
  //
  // Required isolated test secrets (set with `wrangler secret put <name> --env test`):
  //   STRIPE_TEST_SECRET_KEY
  //   STRIPE_TEST_PUBLISHABLE_KEY (reserved for Stripe.js if added later)
  //   STRIPE_TEST_WEBHOOK_SECRET
  // Do not add RESEND_API_KEY to test: test webhooks suppress notifications and fulfilment.
  //
  // Production and test PRODUCT_CODES_DB bindings are isolated. Apply every
  // migration to both databases before deploying. See PRODUCT_CODES.md.
}
